        return player.PlayerGui
            :WaitForChild("Interface")
            :WaitForChild("HUD")
            :WaitForChild("Main")
            :WaitForChild("Top_Boosts")
            :WaitForChild("Gold")
            :WaitForChild("Time")
            :WaitForChild("Time")
            .Text
    end)

    if not success then
        return false
    end

    text = tostring(text)

    if text == "" then
        return false
    end

    if text == "00:00" or text == "0:00" then
        return false
    end

    return true
end


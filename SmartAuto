            end
        end
        if obj.idx == "MissionModifiers" then
            obj.value = obj.value or {}

            obj.value["No Memories"] = true
        end
                    -- =========================
        -- SERUM SYSTEM
        -- =========================
        if obj.idx == "SellSerums" then
            obj.value = true
        end

        if obj.idx == "SerumDropdown" then
            obj.value = {
                ["Armored Serum"] = true,
                ["Female Serum"] = true,
                ["Attack Serum"] = true
            }
        end

        if obj.idx == "SerumSellAmount" then
            obj.value = "10"
        end

        -- =========================
        -- AUTO EQUIP PERKS

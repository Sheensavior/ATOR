local function isUnder12Hours()

    local success, text = pcall(function()
    return player.PlayerGui
        :WaitForChild("Interface")
        :WaitForChild("Gear_Up")
        :WaitForChild("Boosts")
        :WaitForChild("Gold")
        :WaitForChild("Time")
        :WaitForChild("Time")
        .Text
    end)

    if not success then
        return false
    end

    text = tostring(text)

    local h, m, s = text:match("(%d+):(%d+):(%d+)")

    h = tonumber(h)
    m = tonumber(m)
    s = tonumber(s)

    if not h or not m or not s then
        return false
    end

    local totalSeconds =
        (h * 3600) +
        (m * 60) +
        s

    return totalSeconds < (12 * 3600)
end


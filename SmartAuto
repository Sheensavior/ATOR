local function processLogic()
    local prestige = getPrestige()
    local gold = getGold()
    local gems = getGems()
    local level = getLevel()
    local slot = getSlot()

    print("Prestige:", prestige)
    print("Gold:", gold)
    print("Gems:", gems)
    print("Level:", level)
    print("Slot:", slot)

    -- =========================
    -- GLOBAL RULE
    -- =========================
    if prestige == 1 or (prestige == 2 and level < 100) then
        modifyConfig({
            kick = true,
            autoConnect = true,
            addXPBoost = true,
            onlyBuyWhenEmpty = true,
            boostAmount = 1
        })
    end

    if prestige == 2 and level >= 100 then
        modifyConfig({
            kick = true,
            autoConnect = true,
            removeXPBoost = true,
            onlyBuyWhenEmpty = true,
            boostAmount = 2
        })
    end
    if prestige == 3 then
        modifyConfig({
            kick = true,
            autoConnect = true,
            removeXPBoost = true,
            onlyBuyWhenEmpty = true,
            boostAmount = 3
        })
    end
    if prestige == 4 and gold < 950000000 then
        modifyConfig({
            kick = true,
            autoConnect = true,
            removeXPBoost = true,
            onlyBuyWhenEmpty = true,
            boostAmount = 5
        })
    end
    

    -- =========================
    -- SLOT A / B
    -- =========================
    if slot == "A" or slot == "B" then
        if (prestige == 4 and gold > 950000000 and gold < 1000000000) or prestige == 5 then
            if isUnder12Hours() then
                modifyConfig({
                    onlyBuyWhenEmpty = false,
                    addXPBoost = true,
                    boostAmount = 12
                })
            else
                modifyConfig({
                    onlyBuyWhenEmpty = true,
                    removeXPBoost = true,
                    boostAmount = 5
                })
            end
        end

        if prestige == 4 and gold > 1000000000 then

            modifyConfig({
                kick = false,
                autoConnect = false,
                addXPBoost = true,
                keepSpin = true,
                autoSpin = true,
                forceGoldBoost = true
            })

        end

        if prestige == 5 and gems > 50000 then

            modifyConfig({
                kick = false,
                autoConnect = false,
                addXPBoost = true,
                keepSpin = true,
                autoSpin = true,
                spinAmount = "500 Spins",
                forceGoldBoost = true
            })
        end

        if prestige == 5 and gems <= 49999 and gems >= 23000 then
            modifyConfig({
                kick = false,
                autoConnect = false,
                addXPBoost = true,
                keepSpin = true,
                autoSpin = true,
                spinAmount = "250 Spins",
                forceGoldBoost = true
            })
        end

        if prestige == 5 and gems <= 22999 then
            modifyConfig({
                kick = false,
                autoConnect = false,
                keepSpin = false,
                autoSpin = false,
                spinAmount = "500 Spins"
            })
            if slot == "A" then
                setSlot("B")
            elseif slot == "B" then
                setSlot("C")
            end
            task.wait(35)
            local VirtualInputManager = game:GetService("VirtualInputManager")
            local function click(x, y)
                VirtualInputManager:SendMouseMoveEvent(x, y, game)
                task.wait(0.1)
                VirtualInputManager:SendMouseButtonEvent(
                    x,
                   y,
                    0,
                    true,
                    game,
                    1
                )
                task.wait(0.05)
                VirtualInputManager:SendMouseButtonEvent(
                    x,
                    y,
                    0,
                    false,
                    game,
                    1
                )
            end

            click(590, 35)
            task.wait(1)

            click(50, 60)
            task.wait(1)

            click(30, 100)
            task.wait(1)

            click(630, 400)
        end
    end

    -- =========================
    -- SLOT C
    -- =========================
    if slot == "C" then

        if prestige == 4 and gold > 1000000000 then

            modifyConfig({
                autoBoost = false,
                keepSpin = true,
                autoSpin = true,
                spinAmount = "500 Spins"
            })

        end
    end
end

